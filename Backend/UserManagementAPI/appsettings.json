{
  "ConnectionStrings": {
    "DefaultConnection": "Host={DB_HOST};Port=5432;Database={DB_NAME};Username={DB_USER};Password={DB_PASSWORD};"
  },
  "Jwt": {
    "Secret": "your-super-secret-jwt-key-at-least-32-characters-long-replace-in-production",
    "Issuer": "UserManagementApp",
    "Audience": "UserManagementAppUsers",
    "ExpirationMinutes": 60
  },
  "Anthropic": {
    "ApiKey": "{ANTHROPIC_API_KEY}"
  },
  "LocalLLM": {
    "Url": "http://localhost:11434/api/generate",
    "Model": "mistral"
  },
  "UseLocalLLM": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
